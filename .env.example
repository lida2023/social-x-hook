# ═══════════════════════════════════════════
#  SocialX Hook — Configuration
# ═══════════════════════════════════════════

# ── Chain ──────────────────────────
XLAYER_RPC_URL=https://rpc.xlayer.tech

# ── Deployer / Keeper wallet ───────
PRIVATE_KEY=

# ── Contract addresses ─────────────
# Deploy script deploys PoolManager automatically — no need to find one
# Filled by setup.sh after deploy:
HOOK_ADDRESS=
POOL_MANAGER=

# ── X (Twitter) API — READ access ─
# From https://developer.twitter.com → Free tier → Bearer Token
# Only READ permission needed — agent reads engagement, doesn't post
X_BEARER_TOKEN=

# ── KOL handles to track ───────────
TRACKED_KOLS=@your_handle

# ── Agent settings ─────────────────
SCORE_UPDATE_INTERVAL_SEC=600
ENGAGEMENT_DELAY_SEC=900

# Set to true for simulation (no real txs)
DRY_RUN=true
