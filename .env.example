# SocialX Hook configuration

# XLayer mainnet RPC.
XLAYER_RPC_URL=https://rpc.xlayer.tech

# Deployer wallet. Also becomes the initial owner and keeper.
PRIVATE_KEY=

# Official Uniswap v4 PoolManager on X Layer (chain 196).
POOL_MANAGER=0x360E68faCcca8cA495c1B759Fd9EEe466db9FB32

# Filled by setup.sh after hook deployment.
HOOK_ADDRESS=

# X API v2 bearer token with read access.
# The keeper only reads public engagement. It does not post tweets.
X_BEARER_TOKEN=

# Comma-separated X handles that are registered in SocialXHook.
TRACKED_KOLS=@your_handle

# Scoring weights.
SCORE_THRESHOLD=100
LIKE_WEIGHT=1
RETWEET_WEIGHT=2
REPLY_WEIGHT=3
QUOTE_WEIGHT=2

# Keeper loop.
SCORE_UPDATE_INTERVAL_SEC=600

# Set true for local simulation with no chain transaction.
DRY_RUN=false
